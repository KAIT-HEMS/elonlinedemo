{
  "name": "el-demoapp",
  "version": "1.3.2",
  "releaseDate": "2023-10-23",
  "private": true,
  "description": "The ECHONET Lite (EL) Online Control Demonstration Program provides an easy-to-use UI to allow users to search, confugure, or get/set property values of, any EL-compliant devices (or nodes) that can communicate with your system through UDP.",
  "author": "ITRA <info+el@itra.co.jp> (https://www.itra.co.jp/)",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build --skip-plugins @vue/cli-plugin-eslint",
    "lint": "vue-cli-service lint",
    "build:test": "vue-cli-service build --mode development",
    "start": "node ."
  },
  "main": "app.js",
  "dependencies": {
    "axios": "^1.7.9",
    "connect-history-api-fallback": "^2.0.0",
    "core-js": "^3.39.0",
    "deepmerge": "^4.3.1",
    "express": "^4.21.2",
    "json-refs": "^3.0.15",
    "marked": "^15.0.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-eslint": "~5.0.8",
    "@vue/cli-plugin-router": "~5.0.8",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-plugin-vuex": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.4.2",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.83.0",
    "sass-loader": "^13.3.3",
    "typescript": "~5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended",
      "@vue/typescript/recommended",
      "@vue/prettier"
    ],
    "parserOptions": {
      "ecmaVersion": 2020
    },
    "rules": {
      "@typescript-eslint/ban-ts-comment": "off",
      "@typescript-eslint/ban-ts-ignore": "off",
      "prettier/prettier": 0
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "keywords": [
    "echonet",
    "echonet lite",
    "el",
    "iot",
    "kait"
  ],
  "license": "SEE LICENSE IN LICENSE.txt"
}
